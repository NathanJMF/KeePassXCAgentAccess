#!/bin/bash
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if ((EUID == 0)); then
    echo "Run ./install from your desktop account. Keeper requests sudo only for missing Ubuntu packages." >&2
    exit 1
fi

packages=(python3 python3-gi python3-gi-cairo python3-pykeepass gir1.2-gtk-3.0
          gir1.2-secret-1 gir1.2-ayatanaappindicator3-0.1 gnome-keyring)
for option in "$@"; do
    case "$option" in
        --agent) packages+=(acl uidmap util-linux) ;;
        --help|-h) printf '%s\n' 'Usage: ./install [--agent] [--no-launch]' 'Add --agent to set up the isolated agent runner and its user service.'; exit ;;
        --no-launch) ;;
        *) printf 'Unknown option: %s\n' "$option" >&2; exit 2 ;;
    esac
done

missing=()
for package in "${packages[@]}"; do
    if [[ $(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null || true) != installed ]]; then
        missing+=("$package")
    fi
done
if (("${#missing[@]}")); then
    sudo apt-get install "${missing[@]}"
fi
export PYTHONPATH="$root/src"
exec /usr/bin/python3 -m keepassxc_agent_access.installation install "$@"
