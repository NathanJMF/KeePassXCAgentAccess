#!/bin/bash
set -euo pipefail

root=$(CDPATH='' cd -- "$(/usr/bin/dirname -- "$0")" && pwd)
if ((EUID == 0)); then
    echo "Run ./install from your desktop account. Keeper requests sudo only for missing Ubuntu packages." >&2
    exit 1
fi

packages=(python3 python3-gi python3-gi-cairo python3-pykeepass gir1.2-gtk-3.0
          gir1.2-secret-1 gir1.2-ayatanaappindicator3-0.1 gnome-keyring bubblewrap libseccomp2 ca-certificates)
mode=default
for option in "$@"; do
    case "$option" in
        --agent)
            if [[ $mode == connect-agent || $mode == app-only ]]; then
                echo "Use at most one of --connect-agent, --agent, or --app-only." >&2
                exit 2
            fi
            mode=agent
            ;;
        --connect-agent)
            if [[ $mode == agent || $mode == app-only ]]; then
                echo "Use at most one of --connect-agent, --agent, or --app-only." >&2
                exit 2
            fi
            mode=connect-agent
            ;;
        --app-only)
            if [[ $mode == agent || $mode == connect-agent ]]; then
                echo "Use at most one of --connect-agent, --agent, or --app-only." >&2
                exit 2
            fi
            mode=app-only
            ;;
        --help|-h)
            printf '%s\n' \
                'Usage: ./install [--connect-agent | --app-only | --agent] [--no-launch]' \
                'Sets up Keeper with the dedicated MCP runner by default (--connect-agent).' \
                'Use --app-only for desktop-only setup without administrator prompts, or --agent for the legacy runner.'
            exit
            ;;
        --no-launch) ;;
        *) printf 'Unknown option: %s\n' "$option" >&2; exit 2 ;;
    esac
done
if [[ $mode == default || $mode == connect-agent ]]; then
    packages+=(acl pkexec socat gir1.2-webkit2-4.1 xvfb python3-pycryptodome)
elif [[ $mode == agent ]]; then
    packages+=(acl uidmap util-linux gir1.2-webkit2-4.1 xvfb python3-pycryptodome)
fi

missing=()
for package in "${packages[@]}"; do
    if [[ $(/usr/bin/dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null || true) != installed ]]; then
        missing+=("$package")
    fi
done
if (("${#missing[@]}")); then
    /usr/bin/sudo /usr/bin/apt-get install "${missing[@]}"
fi
exec /usr/bin/python3 -I "$root/src/keeper_bootstrap.py" keepassxc_agent_access.installation install "$@"
